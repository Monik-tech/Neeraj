class Solution {
    public int divisorSubstrings(int num, int k) {
        String s = String.valueOf(num);
        int count = 0;

        for (int i = 0; i <= s.length() - k; i++) {
            String temp = s.substring(i, i + k);
            int temp1 = Integer.parseInt(temp);
            
            if (temp1 != 0 && num % temp1 == 0) {
                count++;
            }
        }
        return count;
    }
}
