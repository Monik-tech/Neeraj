class Solution {
    public List<Integer> findAnagrams(String s, String p) {
        List<Integer> result = new ArrayList<>();

        int n = s.length();
        int k = p.length();
        if (k > n) {
            return result;
        }
        int[] countP = new int[26];
        int[] countS = new int[26];

        for (int i = 0; i < k; i++) {
            countP[p.charAt(i) - 'a']++;
            countS[s.charAt(i) - 'a']++;
        }
        if (Arrays.equals(countP, countS)) {
            result.add(0);
        }

        for (int i = k; i < n; i++) {
            countS[s.charAt(i) - 'a']++;
            countS[s.charAt(i - k) - 'a']--;

            if (Arrays.equals(countP, countS)) {
                result.add(i - k + 1);
            }
        }
        return result;
    }
}
